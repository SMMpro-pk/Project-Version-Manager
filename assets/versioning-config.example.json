{
  "schema_version": 1,
  "mode": "auto",
  "strategy": "semver",
  "initial_version": "0.1.0",
  "zero_major_policy": "breaking_to_minor",
  "update_history": "PROJECT_UPDATES.md",
  "changelog": "CHANGELOG.md",
